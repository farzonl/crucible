# DXIL -> SPIR-V test for groupshared memory, barriers, and workgroup atomics.
# REQUIRES: spirv-tools

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/groupshared_reduce.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %spirv-dis %t.spv | FileCheck %s

# CHECK: OpEntryPoint GLCompute %main "main"
# CHECK: OpDecorate {{%[A-Za-z0-9_]+}} BuiltIn LocalInvocationIndex
# CHECK: OpVariable {{%[A-Za-z0-9_]+}} Workgroup
# CHECK: OpControlBarrier
# CHECK: OpAtomicIAdd
# CHECK: OpControlBarrier
