# DXIL -> SPIR-V test for Texture2D SampleLevel, Load, GetDimensions, and RWTexture2D Store.
# REQUIRES: spirv-tools

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/spirv_texture_sample.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %spirv-dis %t.spv | FileCheck %s

# CHECK: OpEntryPoint GLCompute %main "main"
# CHECK-DAG: OpTypeImage %float 2D
# CHECK-DAG: OpTypeSampler
# CHECK: OpImageQuerySizeLod
# CHECK: OpImageSampleExplicitLod
# CHECK: OpImageFetch
# CHECK: OpImageWrite
