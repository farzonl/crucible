# Wave operations must stay inside divergent control flow after LICM.

# RUN: %dxc -T cs_6_5 -E main -Fo %t.dxil %S/../Inputs/wave_divergence.hlsl
# RUN: %cruciblec %t.dxil -o %t.metal
# RUN: FileCheck %s --check-prefix=COUNT --input-file=%t.metal
# RUN: %dxc -T cs_6_5 -E collectives -Fo %t.ops.dxil %S/../Inputs/wave_divergence.hlsl
# RUN: %cruciblec %t.ops.dxil --dump-mlir -o %t.ops.metal 2>&1 | FileCheck %s --check-prefix=OPS

