# REQUIRES: metal-tools
# RUN: %dxc -T lib_6_5 -Fo %t.dxil %S/../Inputs/rt_pipeline.hlsl
# RUN: %cruciblec %t.dxil -o %t.metal
# RUN: FileCheck %s < %t.metal
# RUN: xcrun -sdk macosx metal -std=metal3.1 -Werror -c %t.metal -o %t.air

