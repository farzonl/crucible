# CHECK: static inline void crucible_rt_ClosestHitMain(
# CHECK: static inline void crucible_rt_MissMain(
# CHECK: kernel void
# CHECK: instance_acceleration_structure Scene {{\[\[buffer\(0\)\]\]}}
# CHECK: uint3 dtid {{\[\[thread_position_in_grid\]\]}}
# CHECK: uint3 grid_size {{\[\[threads_per_grid\]\]}}
# CHECK: intersection_query<triangle_data, instancing>
# CHECK: crucible_rt_ClosestHitMain(
# CHECK: crucible_rt_MissMain(
