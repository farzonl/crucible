# SPIR-V -> MSL test: constant buffer (Uniform Block) + structured buffer.

# RUN: %dxc -spirv -T cs_6_0 -E main -Fo %t.spv %S/../Inputs/cbuffer_params.hlsl
# RUN: %cruciblec %t.spv -o %t.metal --reflect %t.json
# RUN: FileCheck %s --input-file=%t.metal
# RUN: FileCheck %s --check-prefix=REFLECT --input-file=%t.json

# CHECK: kernel void main0(
# CHECK-NEXT: device float* __restrict Data {{\[\[}}buffer(0){{\]\]}},
# CHECK-NEXT: constant float4* Params {{\[\[}}buffer(1){{\]\]}},
# CHECK-NEXT: uint3 dtid {{\[\[}}thread_position_in_grid{{\]\]}}) {
# CHECK: if (dtid.x < as_type<uint>(Params[0u].z)) {
# CHECK: Data[dtid.x] = Data[dtid.x] * Params[0u].x + Params[0u].y;
# CHECK: }

# REFLECT: "class": "cbv"
# REFLECT: "metalIndex": 1
# REFLECT: "class": "uav"
# REFLECT: "metalIndex": 0
