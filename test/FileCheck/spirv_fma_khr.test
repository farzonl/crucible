# REQUIRES: spirv-assembler, spirv-tools, spirv-fma-khr
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_fma_khr.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv -o %t.metal
# RUN: FileCheck %s --input-file=%t.metal
# RUN: sed 's/RoundingModeRTE/RoundingModeRTZ/g' %S/../Inputs/spirv_fma_khr.spvasm > %t.rtz.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.rtz.spvasm -o %t.rtz.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.rtz.spv
# RUN: not %cruciblec %t.rtz.spv -o %t.rtz.metal 2>&1 | FileCheck %s --check-prefix=RTZ
# RUN: sed 's/RoundingModeRTE/DenormPreserve/g' %S/../Inputs/spirv_fma_khr.spvasm > %t.denorm.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.denorm.spvasm -o %t.denorm.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.denorm.spv
# RUN: not %cruciblec %t.denorm.spv -o %t.denorm.metal 2>&1 | FileCheck %s --check-prefix=RTZ
# RUN: sed '/OpExtInstImport/d' %S/../Inputs/spirv_fma_khr.spvasm > %t.import.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.import.spvasm -o %t.import.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.import.spv
# RUN: %cruciblec %t.import.spv -o %t.import.metal
# RUN: FileCheck %s --input-file=%t.import.metal
# CHECK: kernel void main0(
# CHECK: float3 {{.*}} = fma(
# CHECK: fma(
# RTZ: unsupported floating-point execution mode for FmaKHR
