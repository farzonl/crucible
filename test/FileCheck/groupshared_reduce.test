# Groupshared memory, threadgroup barriers, and shared atomics.

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/groupshared_reduce.hlsl
# RUN: %cruciblec %t.dxil -o %t.metal
# RUN: FileCheck %s --input-file=%t.metal

# CHECK: kernel void main0(
# CHECK: threadgroup uint [[GS:[A-Za-z0-9_]+]];
# CHECK-DAG: threadgroup_barrier(mem_flags::mem_threadgroup);
# CHECK-DAG: atomic_fetch_add_explicit((threadgroup atomic_uint *)&[[GS]]
# CHECK-NOT: goto

# REQUIRES: metal-tools
# RUN: xcrun -sdk macosx metal -std=metal3.1 -Werror -c %t.metal -o %t.air
