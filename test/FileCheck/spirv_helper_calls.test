# REQUIRES: spirv-assembler, spirv-tools
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_helper_calls.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv --dump-mlir -o %t.metal 2>&1 | FileCheck %s --check-prefix=IR
# RUN: FileCheck %s --input-file=%t.metal
# CHECK: [0u] = 7u;
# CHECK: [1u] =
# IR: func.func @main
# IR-NOT: llvm.call
