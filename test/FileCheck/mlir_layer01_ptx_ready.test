# PTX-readiness smoke test: pure Layer 0 + Layer 1 MLIR (addrspace(1) pointer
# args + gpu.global_id + math.sqrt/fma + scf.if) -> MSL, with zero DXIL or
# SPIR-V artifacts.

# RUN: %cruciblec %S/../Inputs/ptx_ready_kernel.mlir -o %t.metal
# RUN: FileCheck %s --input-file=%t.metal

# CHECK: #include <metal_stdlib>
# CHECK: using namespace metal;
# CHECK: kernel void saxpy(
# CHECK-NEXT: device float* arg0 {{\[\[}}buffer(0){{\]\]}},
# CHECK-NEXT: device float* arg1 {{\[\[}}buffer(1){{\]\]}},
# CHECK-NEXT: device float* arg2 {{\[\[}}buffer(2){{\]\]}},
# CHECK-NEXT: uint3 dtid {{\[\[}}thread_position_in_grid{{\]\]}}) {
# CHECK: if ({{.*}} > 0.0f) {
# CHECK: fma(sqrt({{.*}}), 2.0f, {{.*}})
# CHECK: } else {
# CHECK: arg2[dtid.x] =
