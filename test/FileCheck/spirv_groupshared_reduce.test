# SPIR-V -> MSL test: groupshared (Workgroup) memory, atomics, LocalInvocationIndex, and gpu.barrier.

# RUN: %dxc -spirv -T cs_6_0 -E main -Fo %t.spv %S/../Inputs/groupshared_reduce.hlsl
# RUN: %cruciblec %t.spv -o %t.metal
# RUN: FileCheck %s --input-file=%t.metal

# CHECK: kernel void main0(
# CHECK-NEXT: device uint* Out {{\[\[}}buffer(0){{\]\]}},
# CHECK-NEXT: uint gidx {{\[\[}}thread_index_in_threadgroup{{\]\]}}) {
# CHECK: threadgroup uint gsSum[1];
# CHECK: gsSum[0u] = 0u;
# CHECK: threadgroup_barrier(mem_flags::mem_threadgroup);
# CHECK: atomic_fetch_add_explicit((threadgroup atomic_uint *)&gsSum[0u], gidx, memory_order_relaxed);
# CHECK: threadgroup_barrier(mem_flags::mem_threadgroup);
# CHECK: Out[0u] = gsSum[0u];
