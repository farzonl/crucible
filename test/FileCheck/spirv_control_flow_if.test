# SPIR-V -> MSL test: structured if/else + fmin (LLVM intrinsic).

# RUN: %dxc -spirv -T cs_6_0 -E main -Fo %t.spv %S/../Inputs/control_flow_if.hlsl
# RUN: %cruciblec %t.spv -o %t.metal
# RUN: FileCheck %s --input-file=%t.metal

# CHECK: kernel void main0(
# CHECK-NEXT: device float* __restrict Data {{\[\[}}buffer(0){{\]\]}},
# CHECK-NEXT: uint3 dtid {{\[\[}}thread_position_in_grid{{\]\]}}) {
# CHECK: if ({{.*}} < 2.0f) {
# CHECK: * 3.0f
# CHECK: } else {
# CHECK: min({{.*}}, 10.0f)
# CHECK: }
# CHECK: Data[dtid.x] =
