# CHECK: uint3 dtid {{\[\[}}thread_position_in_grid{{\]\]}}) {
# CHECK-DAG: sqrt(fabs(
# CHECK-DAG: max(
# CHECK-DAG: min(
# CHECK: ?

# REQUIRES: metal-tools
# RUN: xcrun -sdk macosx metal -std=metal3.1 -Werror -c %t.metal -o %t.air
