# DXIL -> SPIR-V test for StorageBuffer atomics (Add, Xor, Exchange).
# REQUIRES: spirv-tools

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/spirv_buffer_atomics.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %spirv-dis %t.spv | FileCheck %s

# CHECK: OpEntryPoint GLCompute %main "main"
# CHECK: OpAtomicIAdd
# CHECK: OpAtomicXor
# CHECK: OpAtomicExchange
