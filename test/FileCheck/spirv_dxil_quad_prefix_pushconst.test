# Regression test for GroupNonUniformQuadSwap (#71) and WavePrefix/WaveIsFirstLane (#186):
# - DXIL lowers exclusive scans to @dx.op.wavePrefixOp and quad swaps to @dx.op.quadOp.
# - Metal lowers quad swaps to quad_shuffle_xor.
# REQUIRES: directx-backend

# RUN: %dxc -spirv -fspv-target-env=vulkan1.1 -T cs_6_5 -E main -Fo %t.spv %S/../Inputs/spirv_dxil_quad_prefix.hlsl
# RUN: %cruciblec --target=dxil --dxil-asm %t.spv | FileCheck %s --check-prefix=DXIL
# RUN: %cruciblec --target=dxil %t.spv -o %t.dxil
# RUN: %cruciblec %t.spv -o %t.metal
# RUN: FileCheck %s --check-prefix=MSL --input-file=%t.metal

# DXIL: define void @main()
# DXIL-DAG: @dx.op.wavePrefixOp.i32(i32 121, {{.*}}, i8 0, i8 0)
# DXIL-DAG: @dx.op.wavePrefixOp.i32(i32 121, {{.*}}, i8 1, i8 0)
# DXIL-DAG: @dx.op.quadOp.i32(i32 123, {{.*}}, i8 0)
# DXIL-DAG: @dx.op.quadOp.i32(i32 123, {{.*}}, i8 1)
# DXIL-DAG: @dx.op.quadOp.i32(i32 123, {{.*}}, i8 2)

# MSL: kernel void
# MSL: quad_shuffle_xor(
