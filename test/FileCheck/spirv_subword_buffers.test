# REQUIRES: spirv-assembler, spirv-tools
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_subword_buffers.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv -o %t.metal
# RUN: FileCheck %s --input-file=%t.metal
# CHECK: device uchar* __restrict
# CHECK: device uchar* __restrict
# CHECK: device ushort* __restrict
# CHECK: * 2u
