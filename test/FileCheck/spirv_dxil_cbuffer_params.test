# SPIR-V -> DXIL test: constant buffer (Uniform Block) + storage buffer + branch.
# REQUIRES: directx-backend

# RUN: %dxc -spirv -T cs_6_0 -E main -Fo %t.spv %S/../Inputs/cbuffer_params.hlsl
# RUN: %cruciblec --target=dxil --dxil-asm %t.spv --reflect %t.json | FileCheck %s
# RUN: %cruciblec --target=dxil %t.spv -o %t.dxil
# RUN: FileCheck %s --check-prefix=REFLECT --input-file=%t.json

# CHECK: define void @main()
# CHECK: @dx.op.threadId.i32(i32 93, i32 0)
# CHECK: @dx.op.cbufferLoadLegacy
# CHECK: @dx.op.rawBufferLoad
# CHECK: @dx.op.rawBufferStore

# REFLECT: "class": "cbv"
# REFLECT: "class": "uav"
