# DXIL -> SPIR-V test for structured loop control flow.
# REQUIRES: spirv-tools

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/loop_accumulate.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %spirv-dis %t.spv | FileCheck %s

# CHECK: OpEntryPoint GLCompute %main "main"
# CHECK: OpLoopMerge
