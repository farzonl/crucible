# REQUIRES: gpu, spirv-assembler, spirv-tools, spirv-float-controls2
# RUN: awk 'BEGIN {print "OpCapability FloatControls2"} /^%%glsl =/ {print "OpExtension \"SPV_KHR_float_controls2\""} /^OpExecutionMode %%main LocalSize/ {print; print "OpExecutionModeId %%main FPFastMathDefault %%float %%flags\nOpExecutionModeId %%main FPFastMathDefault %%half %%flags"; next} /^%%main =/ {print "%%flags = OpConstant %%uint 0"} {print}' %S/../Inputs/spirv_modf_struct.spvasm > %t.struct.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.struct.spvasm -o %t.struct.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.struct.spv
# RUN: %cruciblec %t.struct.spv -o %t.struct.metal --metallib %t.struct.metallib
# RUN: %crucible-run --lib %t.struct.metallib --entry main0 --buffer 0:u32:4:0xbfe00000,0xbf800000,0x7f800000,0xff800000 --buffer 1:u32:12:zero | FileCheck %s --check-prefix=FINITE
# RUN: %crucible-run --lib %t.struct.metallib --entry main0 --buffer 0:u32:4:0x7fc00000,0x80000000,0x3fa00000,0xbe800000 --buffer 1:u32:12:zero | python3 -c "import sys; v=[list(map(int,l.split()[1:])) for l in sys.stdin if l.startswith('buffer1:')]; assert len(v)==1 and len(v[0])==12; v=v[0]; assert all((v[i]&0x7fffffff)>0x7f800000 for i in (0,4,8,9)); assert [v[i] for i in (1,2,3,5,6,7,10,11)]==[2147483648,1048576000,3196059648,2147483648,1065353216,2147483648,2147483648,2147483648],v"
# RUN: awk '/^%%main =/ {print "%%pv = OpTypePointer Function %%v4float\n%%ph = OpTypePointer Function %%v4half\n%%ps = OpTypePointer Function %%float"} /^%%entry =/ {print; print "%%wv = OpVariable %%pv Function\n%%wh = OpVariable %%ph Function\n%%ws = OpVariable %%ps Function"; next} /^%%result =/ {print "%%fraction = OpExtInst %%v4float %%glsl Modf %%v %%wv"; next} /^%%fraction =/ {next} /^%%whole =/ {print "%%whole = OpLoad %%v4float %%wv"; next} /^%%hr =/ {print "%%hf = OpExtInst %%v4half %%glsl Modf %%h %%wh"; next} /^%%hf =/ {next} /^%%hw =/ {print "%%hw = OpLoad %%v4half %%wh"; next} /^%%sr =/ {print "OpStore %%ws %%b\n%%alias = OpLoad %%float %%ws\n%%sf = OpExtInst %%float %%glsl Modf %%alias %%ws"; next} /^%%sf =/ {next} /^%%sw =/ {print "%%sw = OpLoad %%float %%ws"; next} {print}' %t.struct.spvasm > %t.ptr.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.ptr.spvasm -o %t.ptr.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.ptr.spv
# RUN: %cruciblec %t.ptr.spv -o %t.ptr.metal --metallib %t.ptr.metallib
# RUN: %crucible-run --lib %t.ptr.metallib --entry main0 --buffer 0:u32:4:0xbfe00000,0xbfa00000,0x7f800000,0xff800000 --buffer 1:u32:12:zero | FileCheck %s --check-prefix=POINTER
# RUN: %crucible-run --lib %t.ptr.metallib --entry main0 --buffer 0:u32:4:0x7fc00000,0x80000000,0x3fa00000,0xbe800000 --buffer 1:u32:12:zero | python3 -c "import sys; v=[list(map(int,l.split()[1:])) for l in sys.stdin if l.startswith('buffer1:')]; assert len(v)==1 and len(v[0])==12; v=v[0]; assert all((v[i]&0x7fffffff)>0x7f800000 for i in (0,4,8,9)); assert [v[i] for i in (1,2,3,5,6,7,10,11)]==[2147483648,1048576000,3196059648,2147483648,1065353216,2147483648,2147483648,2147483648],v"
# FINITE: buffer1: 3208642560 2147483648 0 2147483648 3212836864 3212836864 2139095040 4286578688 3208642560 3212836864 2147483648 3212836864
# POINTER: buffer1: 3208642560 3196059648 0 2147483648 3212836864 3212836864 2139095040 4286578688 3208642560 3212836864 3196059648 3212836864
