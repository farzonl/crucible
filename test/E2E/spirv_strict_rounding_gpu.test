# REQUIRES: gpu, spirv-assembler, spirv-tools, spirv-float-controls2
# RUN: sed 's/ FAbs / RoundEven /g' %S/../Inputs/spirv_float_controls2.spvasm > %t.round.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.round.spvasm -o %t.round.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.round.spv
# RUN: %cruciblec %t.round.spv -o %t.round.metal --metallib %t.round.metallib
# RUN: %crucible-run --lib %t.round.metallib --entry main0 --groups 4,1,1 --threads 1,1,1 --buffer 0:u32:4:0x3fc00000,0xc0200000,0x3e00,0xc100 --buffer 1:u32:4:0x40200000,0x80000000,0xc100,0x3e00 --buffer 2:u32:40:zero | FileCheck %s --check-prefix=ROUND
# RUN: sed 's/ FAbs / Floor /g' %S/../Inputs/spirv_float_controls2.spvasm > %t.floor.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.floor.spvasm -o %t.floor.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.floor.spv
# RUN: %cruciblec %t.floor.spv -o %t.floor.metal --metallib %t.floor.metallib
# RUN: %crucible-run --lib %t.floor.metallib --entry main0 --groups 3,1,1 --threads 1,1,1 --buffer 0:u32:3:0xbfa00000,0x7fc07e00,0x80008000 --buffer 1:u32:3:0x3fa00000,0x3f803c00,0 --buffer 2:u32:30:zero | FileCheck %s --check-prefix=FLOOR
# RUN: sed 's/FAbs %a$/NMin %a %b/; s/FAbs %ah$/NMin %ah %bh/; s/FAbs %va$/NMin %va %vb/' %S/../Inputs/spirv_float_controls2.spvasm > %t.min.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.min.spvasm -o %t.min.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.min.spv
# RUN: %cruciblec %t.min.spv -o %t.min.metal --metallib %t.min.metallib
# RUN: %crucible-run --lib %t.min.metallib --entry main0 --groups 3,1,1 --threads 1,1,1 --buffer 0:u32:3:0x80008000,0x7fc07e00,0xff800000 --buffer 1:u32:3:0,0x3f803c00,0x7f800000 --buffer 2:u32:30:zero | FileCheck %s --check-prefix=MIN
# RUN: sed 's/OpExtInst %f32 %glsl FAbs %a$/OpFSub %f32 %a %b/; s/OpExtInst %f16 %glsl FAbs %ah$/OpFSub %f16 %ah %bh/; s/OpExtInst %v2f32 %glsl FAbs %va$/OpFSub %v2f32 %va %vb/' %S/../Inputs/spirv_float_controls2.spvasm > %t.sub.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.sub.spvasm -o %t.sub.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.sub.spv
# RUN: %cruciblec %t.sub.spv -o %t.sub.metal --metallib %t.sub.metallib
# RUN: %crucible-run --lib %t.sub.metallib --entry main0 --groups 4,1,1 --threads 1,1,1 --buffer 0:u32:4:0x80000000,0x80000000,0xbf808000,0xbf808000 --buffer 1:u32:4:0x80000000,0,0xbf808000,0xbf800000 --buffer 2:u32:40:zero | FileCheck %s --check-prefix=SUB
