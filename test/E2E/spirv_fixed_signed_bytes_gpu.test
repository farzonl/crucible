# REQUIRES: gpu, spirv-assembler, spirv-tools
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_fixed_signed_bytes.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv -o %t.metal --metallib %t.metallib
# RUN: %crucible-run --lib %t.metallib --entry main0 --threads 2,1,1 --groups 1,1,1 --buffer 0:u32:4:0xffffffff,42,0xffffff80,127 --buffer 1:u32:2:0xa5a5a5a5,0xa5a5a5a5 | FileCheck %s
# CHECK: buffer1: 2139106047 2779096485
