# REQUIRES: gpu, offload-runner
# RUN: %api_query | FileCheck %s

# CHECK: Architecture: "{{[^"]+}}"
# CHECK: - API: DirectX
# CHECK-NEXT: Description: {{.+}}
# CHECK-NEXT: Driver: Crucible
# CHECK: DoublePrecisionFloatShaderOps: true
# CHECK: Backend: Metal
# CHECK-NEXT: RegistryID: {{[1-9][0-9]*}}
# CHECK: - API: Vulkan
# CHECK-NEXT: Description: {{.+}} (Crucible)
# CHECK-NEXT: Driver: Crucible
# CHECK: shaderFloat64: true
