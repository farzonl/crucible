# REQUIRES: gpu, spirv-assembler, spirv-tools, spirv-float-controls2
# RUN: awk '/^%%main =/ {print "%%vh = OpTypeVector %%f16 2\n%%mh = OpTypeMatrix %%vh 2"} /^%%abs =/ {print "%%c0 = OpCompositeConstruct %%v2f32 %%a %%b\n%%c1 = OpCompositeConstruct %%v2f32 %%b %%a\n%%m = OpCompositeConstruct %%m2f32 %%c0 %%c1"; print "%%abs = OpExtInst %%f32 %%glsl Determinant %%m"; next} /^%%habs =/ {print "%%hc0 = OpCompositeConstruct %%vh %%ah %%bh\n%%hc1 = OpCompositeConstruct %%vh %%bh %%ah\n%%hm = OpCompositeConstruct %%mh %%hc0 %%hc1"; print "%%habs = OpExtInst %%f16 %%glsl Determinant %%hm"; next} /^%%vabs =/ {print "%%vabs = OpCompositeConstruct %%v2f32 %%abs %%abs"; next} {print}' %S/../Inputs/spirv_float_controls2.spvasm > %t.det.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.det.spvasm -o %t.det.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.det.spv
# RUN: %cruciblec %t.det.spv -o %t.det.metal --metallib %t.det.metallib
# RUN: %crucible-run --lib %t.det.metallib --entry main0 --groups 6,1,1 --threads 1,1,1 --buffer 0:u32:6:0x80000000,0xbf808000,0x3f803e00,0x7f807c00,0x7fc07e00,0xbf80be00 --buffer 1:u32:6:0,0x3f800000,0x40003c00,0x3f803c00,0x3f803c00,0xbf803c00 --buffer 2:u32:60:zero | python3 %S/../Inputs/check_strict_math.py Determinant
# RUN: awk '/^%%main =/ {print "%%fone = OpConstant %%f32 1\n%%hone = OpConstant %%f16 1"} /^%%c1 =/ {print "%%c1 = OpCompositeConstruct %%v2f32 %%b %%fone"; next} /^%%hc1 =/ {print "%%hc1 = OpCompositeConstruct %%vh %%bh %%hone"; next} {print}' %t.det.spvasm > %t.asym.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.asym.spvasm -o %t.asym.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.asym.spv
# RUN: %cruciblec %t.asym.spv -o %t.asym.metal --metallib %t.asym.metallib
# RUN: %crucible-run --lib %t.asym.metallib --entry main0 --groups 2,1,1 --threads 1,1,1 --buffer 0:u32:2:0x80000000,0xbf808000 --buffer 1:u32:2:zero --buffer 2:u32:20:zero | FileCheck %s --check-prefix=ASYM
# RUN: awk '/^%%main =/ {print "%%fz = OpConstant %%f32 0\n%%fm = OpConstant %%f32 -1\n%%normal = OpConstantComposite %%v2f32 %%fz %%fm"} {print}' %S/../Inputs/spirv_float_controls2.spvasm | sed 's/FAbs %%a$/Reflect %%a %%b/; s/FAbs %%ah$/Reflect %%ah %%bh/; s/FAbs %%va$/Reflect %%va %%normal/' > %t.reflect.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.reflect.spvasm -o %t.reflect.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.reflect.spv
# RUN: %cruciblec %t.reflect.spv -o %t.reflect.metal --metallib %t.reflect.metallib
# RUN: %crucible-run --lib %t.reflect.metallib --entry main0 --groups 6,1,1 --threads 1,1,1 --buffer 0:u32:6:0x80000000,0xbf808000,0x3f803e00,0x7f807c00,0x7fc07e00,0xbf80be00 --buffer 1:u32:6:0,0x3f800000,0x40003c00,0x3f803c00,0x3f803c00,0xbf803c00 --buffer 2:u32:60:zero | python3 %S/../Inputs/check_strict_math.py Reflect
# ASYM: buffer2: 1 1 0 0 2147483648 1 0 0 1 2147483648 0 0 1 1 3212869632 1 0 32768 0 3212869632
