# End-to-end GPU test for constant buffers (mixed float/uint fields).
# REQUIRES: gpu

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/cbuffer_params.hlsl
# RUN: %cruciblec %t.dxil -o %t.metal --metallib %t.metallib
# RUN: %crucible-run --lib %t.metallib --entry main0 --threads 8,1,1 \
# RUN:   --groups 1,1,1 --buffer 0:f32:8:iota \
# RUN:   --buffer 1:f32:4:2.0,1.0,0x5,0 | FileCheck %s

# scale=2, bias=1, count=5 (raw uint bits): i<5 -> i*2+1, else untouched.
# CHECK: buffer0: 1 3 5 7 9 5 6 7
