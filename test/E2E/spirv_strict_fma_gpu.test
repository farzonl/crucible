# REQUIRES: gpu, spirv-assembler, spirv-tools, spirv-float-controls2
# RUN: awk '/^%%main =/ {print "%%fz = OpConstant %%f32 0\n%%hz = OpConstant %%f16 0\n%%vz = OpConstantComposite %%v2f32 %%fz %%fz"} {print}' %S/../Inputs/spirv_float_controls2.spvasm | sed 's/FAbs %%a$/Fma %%a %%b %%fz/; s/FAbs %%ah$/Fma %%ah %%bh %%hz/; s/FAbs %%va$/Fma %%va %%vb %%vz/' > %t.zero.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.zero.spvasm -o %t.zero.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.zero.spv
# RUN: %cruciblec %t.zero.spv -o %t.zero.metal --metallib %t.zero.metallib
# RUN: %crucible-run --lib %t.zero.metallib --entry main0 --groups 3,1,1 --threads 1,1,1 --buffer 0:u32:3:0xbf808000,0x3f803c01,0x3f803c01 --buffer 1:u32:3:0x3f803c00,0x3f803bff,0x3f803c01 --buffer 2:u32:30:zero | FileCheck %s --check-prefix=ZERO
# RUN: sed 's/OpConstant %%f32 0$/OpConstant %%f32 -1/; s/OpConstant %%f16 0$/OpConstant %%f16 -1/' %t.zero.spvasm > %t.fused.spvasm
# RUN: %spirv-as --target-env vulkan1.3 %t.fused.spvasm -o %t.fused.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.fused.spv
# RUN: %cruciblec %t.fused.spv -o %t.fused.metal --metallib %t.fused.metallib
# RUN: %crucible-run --lib %t.fused.metallib --entry main0 --groups 3,1,1 --threads 1,1,1 --buffer 0:u32:3:0xbf808000,0x3f803c01,0x3f803c01 --buffer 1:u32:3:0x3f803c00,0x3f803bff,0x3f803c01 --buffer 2:u32:30:zero | FileCheck %s --check-prefix=FUSED
