# REQUIRES: gpu, spirv-assembler, spirv-tools
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_dot_acc_sat.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv -o %t.metal --metallib %t.metallib
# RUN: %crucible-run --lib %t.metallib --entry main0 --threads 1,1,1 --groups 1,1,1 --buffer 0:u32:3:0x01010101,0x02020202,0xffffffff --buffer 1:u32:12:zero | FileCheck %s
# CHECK: buffer1: 2147483647 2147483648 4294967295 9 127 128 32767 32768 65535 255 25 9
