# REQUIRES: gpu, spirv-assembler, spirv-tools, spirv-float-controls2
# RUN: bash -o pipefail -c 'for op in Acosh Cosh Exp Log2 Atan2; do sed "s/ FAbs / $op /g" %S/../Inputs/spirv_float_controls2.spvasm | sed "s/Atan2 %%a$/Atan2 %%a %%b/; s/Atan2 %%ah$/Atan2 %%ah %%bh/; s/Atan2 %%va$/Atan2 %%va %%vb/" > %t.$op.spvasm; %spirv-as --target-env vulkan1.3 %t.$op.spvasm -o %t.$op.spv && %spirv-val --target-env vulkan1.3 %t.$op.spv && %cruciblec %t.$op.spv -o %t.$op.metal --metallib %t.$op.metallib || exit 1; done'
# RUN: bash -o pipefail -c 'for op in Acosh Cosh Exp Log2 Atan2; do %crucible-run --lib %t.$op.metallib --entry main0 --groups 16,1,1 --threads 1,1,1 --buffer 0:u32:16:0x7f80fc00,0x7fc07e00,0x3f803c00,0x3f805cb0,0x00807bff,0xbf80bc00,0x3f803800,0x3f807800,0x3f803c01,0x3f800000,0x80000000,0xff800000,0,0x7f7fffff,0x40003c00,0xbf00bc00 --buffer 1:u32:16:0xff807c00,0x3f803c00,0xff80fc00,0x3f803c00,0x3f803c00,0x3f803c00,0x3f803c00,0x80000000,0xbf800000,0xff80fc00,0xff800000,0x7f800000,0xff800000,0x3f803c00,0x40403c00,0x3f803c00 --buffer 2:u32:160:zero | python3 %S/../Inputs/check_strict_math.py $op || exit 1; done'
