# End-to-end DXIL -> SPIR-V -> Vulkan/MoltenVK GPU execution with structured loop.
# REQUIRES: spirv-tools, vulkan-gpu

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/loop_accumulate.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %crucible-run --backend vulkan --spv %t.spv --entry main --groups 1,1,1 --buffer 0:f32:8:iota | FileCheck %s

# acc(id) = sum of Data[i] for i < id where Data[i] <= 4 (Data = iota)
# CHECK: buffer0: 0 0 1 3 6 10 10 10
