# End-to-end DXIL -> SPIR-V -> Vulkan/MoltenVK GPU execution with CBuffer.
# REQUIRES: spirv-tools, vulkan-gpu

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/cbuffer_params.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %crucible-vk-run --spv %t.spv --entry main --groups 1,1,1 --buffer 0:f32:8:iota --cbuffer 1:f32:4:2.0,1.0,0x5,0 | FileCheck %s

# scale=2, bias=1, count=5 (raw uint bits): i<5 -> i*2+1, else untouched.
# CHECK: buffer0: 1 3 5 7 9 5 6 7
