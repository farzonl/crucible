# REQUIRES: gpu, spirv-assembler, spirv-tools
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_local_arrays.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv -o %t.metal --metallib %t.metallib
# RUN: %crucible-run --lib %t.metallib --entry main0 --threads 1,1,1 --groups 1,1,1 --buffer 0:u32:2:3,42 --buffer 1:f32:8:zero | FileCheck %s --check-prefix=UPDATED
# RUN: %crucible-run --lib %t.metallib --entry main0 --threads 1,1,1 --groups 1,1,1 --buffer 0:u32:2:4,42 --buffer 1:f32:8:zero | FileCheck %s --check-prefix=UNCHANGED
# UPDATED: buffer1: 1 4 42 -42 5 4 42 -42
# UNCHANGED: buffer1: 1 4 42 -42 5 4 5 1
