# End-to-end DXIL -> SPIR-V -> Vulkan/MoltenVK GPU execution: Out[i] = Out[i] * 2 + 1.
# REQUIRES: spirv-tools, vulkan-gpu

# RUN: %dxc -T cs_6_0 -E main -Fo %t.dxil %S/../Inputs/simple_compute.hlsl
# RUN: %cruciblec --target=spirv %t.dxil -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %crucible-vk-run --spv %t.spv --entry main --groups 1,1,1 --buffer 0:f32:8:iota | FileCheck %s

# CHECK: buffer0: 1 3 5 7 9 11 13 15
