# REQUIRES: gpu, spirv-assembler, spirv-tools
# RUN: %spirv-as --target-env vulkan1.3 %S/../Inputs/spirv_ldexp.spvasm -o %t.spv
# RUN: %spirv-val --target-env vulkan1.3 %t.spv
# RUN: %cruciblec %t.spv -o %t.metal --metallib %t.metallib
# RUN: %crucible-run --lib %t.metallib --entry main0 --groups 8,1,1 --threads 1,1,1 --buffer 0:u32:8:0xbf800000,0xbf800000,0xbf800000,0xbf800000,0xbf800000,0xbf800000,0xbf800000,0xbf800000 --buffer 1:u32:16:1,0,0,0,0xffffffff,0xffffffff,0xfffffffe,0xffffffff,0xfffffff2,0xffffffff,5,0x80000000,4,0x80000000,3,0x80000000 --buffer 2:u32:48:zero | python3 %S/../Inputs/check_ldexp.py
# RUN: %crucible-run --lib %t.metallib --entry main0 --groups 18,1,1 --threads 1,1,1 --buffer 0:u32:18:0x80000000,0,0x7f800000,0xff800000,0x7fc00001,0x7f800001,0x3f800000,0xbf800000,0x3f800000,0xbf800000,0x7f7fffff,0x00800000,0x3f800000,0x3f800000,0xbf800000,0x3f800001,0xbf800000,0xc0b00000 --buffer 1:u32:36:0,1,0,0x80000000,0,0x80000000,0xffffffff,0x7fffffff,5,0xffffffff,5,1,0xffffffff,0x7fffffff,0,0x80000000,1,1,1,0xffffffff,1,0,1,0,0xffffff82,0xffffffff,0xffffff81,0xffffffff,0xffffff6b,0xffffffff,0xffffff6a,0xffffffff,0xffffff6a,0xffffffff,3,0 --buffer 2:u32:108:zero | python3 %S/../Inputs/check_ldexp.py
