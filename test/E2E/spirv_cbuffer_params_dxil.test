# End-to-end SPIR-V -> DXIL -> Nacelle D3D12 execution test with CBuffer.
# REQUIRES: directx-backend, nacelle-d3d12

# RUN: %dxc -spirv -T cs_6_0 -E main -Fo %t.spv %S/../Inputs/cbuffer_params.hlsl
# RUN: %cruciblec --target=dxil %t.spv -o %t.dxil
# RUN: %nacelle-compile --cs %t.dxil --emit-scf > /dev/null
# RUN: %crucible-run --backend d3d12 --dxil %t.dxil --groups 1,1,1 \
# RUN:   --buffer 0:f32:8:iota --cbuffer 0:f32:4:2.0,1.0,0x5,0 | FileCheck %s

# scale=2, bias=1, count=5 (raw uint bits): i<5 -> i*2+1, else untouched.
# CHECK: buffer0: 1 3 5 7 9 5 6 7
